@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h4 class="mb-4 text-warning">Security Settings</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <input asp-for="Input.OldPassword" class="form-control" id="oldPass" autocomplete="current-password" aria-required="true" placeholder="Old Password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <label asp-for="Input.OldPassword">Current Password</label>
                </div>
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassGlobal('oldPass', 'oldIcon')" style="border-top-right-radius: 5px; border-bottom-right-radius: 5px;">
                    <i class="bi bi-eye" id="oldIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-danger d-block mb-3"></span>

            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <input asp-for="Input.NewPassword" class="form-control" id="newPass" autocomplete="new-password" aria-required="true" placeholder="New Password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <label asp-for="Input.NewPassword">New Password</label>
                </div>
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassGlobal('newPass', 'newIcon')" style="border-top-right-radius: 5px; border-bottom-right-radius: 5px;">
                    <i class="bi bi-eye" id="newIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-danger d-block mb-3"></span>

            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <input asp-for="Input.ConfirmPassword" class="form-control" id="confPass" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
                </div>
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassGlobal('confPass', 'confIcon')" style="border-top-right-radius: 5px; border-bottom-right-radius: 5px;">
                    <i class="bi bi-eye" id="confIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mb-3"></span>

            <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Update Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}