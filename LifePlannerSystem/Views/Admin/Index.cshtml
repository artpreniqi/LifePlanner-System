@model IEnumerable<LifePlanner.Models.ApplicationUser>

@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
        <h2 class="text-danger"><i class="bi bi-shield-lock-fill"></i> System Administration</h2>
        <span class="badge bg-danger">Authorized Personnel Only</span>
    </div>

    <a asp-action="CreateUser" class="btn btn-success shadow-sm">
        <i class="bi bi-person-plus-fill"></i> Create New User
    </a>

    <br />
    <br />

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Registered Users Management</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User ID (Partial)</th>
                        <th>Email Address</th>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><code>@user.Id.Substring(0, 8)...</code></td>
                            <td>@user.Email</td>
                            <td>@user.FullName</td>
                            <td>@user.UserName</td>
                            <td class="text-end">
                                @if(user.UserName != "admin@lifeplanner.com") 
                                {
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-2">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this user?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-success">Super Admin</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>