@model IEnumerable<LifePlanner.Models.LifeGoal>

@{
    ViewData["Title"] = "Life Goals";
    
    // Two lists: Active and Achieved
    var activeGoals = Model.Where(g => g.ProgressPercentage < 100).ToList();
    var achievedGoals = Model.Where(g => g.ProgressPercentage == 100).ToList();
}

<div class="p-5 mb-5 bg-dark rounded-3 text-white shadow" 
     style="background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); position: relative; overflow: hidden;">
    <div class="position-relative z-index-1 text-center">
        <h1 class="display-4 fw-bold mb-3">Life Vision Board</h1>
        <p class="lead text-light opacity-75 mb-4">"Design a life that you are inspired to live."</p>
        <a asp-action="Create" class="btn btn-outline-light btn-lg px-5 rounded-pill fw-bold">
            <i class="bi bi-plus-lg me-2"></i>New Goal
        </a>
    </div>
</div>

<div class="container mb-5">
    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0"><i class="bi bi-bullseye text-primary me-2"></i>Current Ambitions</h3>
        <span class="badge bg-light text-dark border ms-3">@activeGoals.Count Active</span>
    </div>

    @if (!activeGoals.Any())
    {
        <div class="text-center py-5 border rounded-3 bg-light">
            <i class="bi bi-compass display-4 text-muted opacity-25"></i>
            <p class="text-muted mt-3">No active goals. Add one to start your journey!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in activeGoals)
            {
                // Colors and active icons based on category
                var cat = item.Category ?? "General";
                string badgeColor = "bg-primary";
                string icon = "bi-star-fill";
                
                if (cat == "Health") { badgeColor = "bg-danger"; icon = "bi-heart-pulse-fill"; }
                else if (cat == "Finance") { badgeColor = "bg-success"; icon = "bi-cash-coin"; }
                else if (cat == "Career") { badgeColor = "bg-info"; icon = "bi-briefcase-fill"; }

                int progress = item.ProgressPercentage;
                string progressColor = progress < 30 ? "bg-danger" : (progress < 70 ? "bg-warning" : "bg-success");
                
                var daysLeft = (item.TargetDate - DateTime.Now).Days;
                string daysText = daysLeft > 0 ? $"{daysLeft} days left" : "Deadline passed";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-white hover-card">
                        <div class="card-header bg-transparent border-0 d-flex justify-content-between pt-3">
                            <span class="badge @badgeColor rounded-pill px-3"><i class="bi @icon me-1"></i> @cat</span>
                            
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                    <li><a asp-action="Delete" asp-route-id="@item.Id" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.GoalName</h5>
                            <p class="text-muted small text-truncate">@item.Description</p>
                            
                            <div class="d-flex align-items-center mb-3 small text-muted">
                                <i class="bi bi-calendar me-2"></i> @item.TargetDate.ToString("dd MMM yyyy")
                                <span class="ms-auto text-primary fw-bold">@daysText</span>
                            </div>

                            <div class="d-flex justify-content-between small fw-bold mb-1">
                                <span>Progress</span>
                                <span>@progress%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @progressColor" style="width: @progress%"></div>
                            </div>

                            <button class="btn btn-sm btn-outline-primary w-100 mt-4 rounded-pill" data-bs-toggle="modal" data-bs-target="#progressModal-@item.Id">
                                Update Progress
                            </button>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="progressModal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Update: @item.GoalName</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="UpdateProgress" method="post">
                                <div class="modal-body text-center">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <h2 class="display-4 fw-bold text-primary"><span id="val-@item.Id">@item.ProgressPercentage</span>%</h2>
                                    <input type="range" class="form-range" min="0" max="100" step="5" name="newProgress" value="@item.ProgressPercentage" oninput="document.getElementById('val-@item.Id').innerText = this.value">
                                </div>
                                <div class="modal-footer"><button type="submit" class="btn btn-primary">Save</button></div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<hr class="my-5 border-2 opacity-50">

<div class="container mb-5">
    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0">
            <i class="bi bi-award-fill text-warning me-2"></i>Achievements
        </h3>
        <span class="badge bg-warning text-dark border ms-3">@achievedGoals.Count Unlocked</span>
    </div>

    @if (!achievedGoals.Any())
    {
        <div class="text-center py-4 opacity-50">
            <small>No achievements yet. Keep pushing!</small>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in achievedGoals)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow" style="background: linear-gradient(145deg, #fffbf2, #fff);">
                        
                        <div class="card-body border-start border-5 border-warning rounded-3 position-relative">
                            
                            <i class="bi bi-patch-check-fill position-absolute" style="font-size: 5rem; right: 10px; bottom: 10px; color: #f0ad4e; opacity: 0.1;"></i>

                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-warning text-dark"><i class="bi bi-check-circle-fill me-1"></i> Done</span>
                                
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                        <li><a asp-action="Delete" asp-route-id="@item.Id" class="dropdown-item text-danger">Delete Achievement</a></li>
                                        <li>
                                            <form asp-action="UpdateProgress" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="newProgress" value="95" />
                                                <button type="submit" class="dropdown-item text-secondary">Mark as Incomplete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">@item.GoalName</h5>
                            <p class="small text-muted fst-italic">"@item.Description"</p>
                            
                            <div class="mt-3 pt-3 border-top border-warning border-opacity-25">
                                <small class="text-success fw-bold">
                                    <i class="bi bi-calendar-check-fill me-1"></i> Achieved on: @item.TargetDate.ToString("dd MMM yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>