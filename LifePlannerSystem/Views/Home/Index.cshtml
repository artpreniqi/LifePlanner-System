@model IEnumerable<LifePlanner.Models.ToDoItem>

@{
    ViewData["Title"] = User.Identity.IsAuthenticated ? "My Dashboard" : "Welcome to LifePlanner";
}

@if (User.Identity.IsAuthenticated)
{

    // DASHBOARD For Authenticated Users

    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />

    <style>
        /* LIGHT MODE (STANDARD) */
        body {
            background-color: #f4f6f9;
            color: #2c3e50;
        }

        .soft-card {
            background: #ffffff;
            box-shadow: 0 10px 25px rgba(17, 153, 142, 0.05);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            transition: all 0.3s ease;
        }
        .soft-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(17, 153, 142, 0.1);
        }

        /* Calendar Container Light */
        #calendar-container {
            background: white;
            padding: 25px;
            border-radius: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }

        /* Status colors */
        .bg-soft-primary { background-color: #e3f2fd; color: #0d6efd; }
        .bg-soft-success { background-color: #e8f5e9; color: #198754; }
        .bg-soft-warning { background-color: #fff3cd; color: #ffc107; }
        .bg-soft-info    { background-color: #cff4fc; color: #0dcaf0; }

        /* DARK MODE STYLES */
        body.dark-mode {
            background-color: #0b0e14 !important;
            color: #cbd5e1 !important;
        }

        body.dark-mode .soft-card,
        body.dark-mode #calendar-container,
        body.dark-mode .modal-content {
            background-color: #151a23 !important;
            border: 1px solid #2a3241 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            color: #e2e8f0 !important;
        }

        body.dark-mode .soft-card:hover {
            background-color: #1c222e !important;
            border-color: #38ef7d !important;
        }

        /* Icon Colors in Dark Mode (GLOW EFFECT) */
        body.dark-mode .bg-soft-primary { background-color: rgba(13, 110, 253, 0.15) !important; color: #6ea8fe !important; }
        body.dark-mode .bg-soft-success { background-color: rgba(25, 135, 84, 0.15) !important; color: #75b798 !important; }
        body.dark-mode .bg-soft-warning { background-color: rgba(255, 193, 7, 0.15) !important; color: #ffda6a !important; }
        body.dark-mode .bg-soft-info    { background-color: rgba(13, 202, 240, 0.15) !important; color: #6edff6 !important; }

        body.dark-mode .task-card-item {
            background-color: #151a23 !important;
            border-color: #2a3241 !important;
            color: #e2e8f0 !important;
        }
        body.dark-mode .task-card-item:hover {
            background-color: #1e2530 !important;
            cursor: pointer;
        }

        body.dark-mode .fc-theme-standard td,
        body.dark-mode .fc-theme-standard th {
            border-color: #2a3241 !important;
        }
        body.dark-mode .fc-col-header-cell-cushion,
        body.dark-mode .fc-daygrid-day-number {
            color: #94a3b8 !important;
            text-decoration: none;
        }
        body.dark-mode .fc-toolbar-title {
            color: #ffffff !important;
        }
        body.dark-mode .fc-day-today {
            background-color: rgba(56, 239, 125, 0.05) !important;
        }

        /* Calendar buttons */
        .fc-button-primary {
            background-color: #4f46e5 !important;
            border: none !important;
            box-shadow: 0 4px 6px rgba(79, 70, 229, 0.3);
        }
        .fc-button-primary:hover {
            background-color: #4338ca !important;
        }

        body.dark-mode .welcome-text { color: #ffffff !important; }
        body.dark-mode .welcome-text span { color: #38ef7d !important; text-shadow: 0 0 10px rgba(56, 239, 125, 0.4); }

        body.dark-mode .hero-illustration {
            filter: brightness(0.8) contrast(1.2);
        }
    </style>

    <div class="container-fluid py-4">

        <div class="row align-items-center mb-5">
            <div class="col-md-7">
                <h1 class="display-5 fw-bold welcome-text" style="color: #333;">
                    Good Morning, <span style="color: #6c63ff;">@ViewBag.UserName</span>! 👋
                </h1>
                <p class="lead text-muted">You have <strong class="text-primary">@ViewBag.TotalTasks tasks</strong> pending. Let's make today productive.</p>
            </div>
            <div class="col-md-5 text-center d-none d-md-block">
                <img src="~/images/dashboard_illustration.png" alt="Planning" class="hero-illustration" style="max-width: 100%;" onerror="this.style.display='none'">
            </div>
        </div>

        <div class="row mb-5 g-4">
            <div class="col-md-4">
                <div class="card soft-card h-100 p-3">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-soft-primary p-4 rounded-circle me-4">
                            <i class="bi bi-list-task fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Pending Tasks</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.TotalTasks</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card soft-card h-100 p-3">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-soft-success p-4 rounded-circle me-4">
                            <i class="bi bi-check-circle-fill fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Completed</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.CompletedTasks</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card soft-card h-100 p-3">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-soft-info p-4 rounded-circle me-4">
                            <i class="bi bi-trophy-fill fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Active Goals</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.ActiveGoals</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-5">

            <div class="col-lg-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0"><i class="bi bi-hourglass-split me-2 text-warning"></i>Up Next</h5>
                    <a asp-controller="ToDo" asp-action="Index" class="btn btn-sm btn-light rounded-pill fw-bold text-primary">View All</a>
                </div>

                @if (Model != null && !Model.Any())
                {
                    <div class="text-center py-5 soft-card">
                        <i class="bi bi-emoji-smile display-4 text-muted opacity-50"></i>
                        <p class="mt-3 fw-bold text-muted">Nothing urgent right now!</p>
                        <a asp-controller="ToDo" asp-action="Create" class="btn btn-primary rounded-pill fw-bold">Plan Something</a>
                    </div>
                }
                else if (Model != null)
                {
                    <div class="list-group list-group-flush bg-transparent">
                        @foreach (var task in Model)
                        {
                            var timeRemaining = task.DueDate - DateTime.Now;
                            bool isUrgent = timeRemaining.TotalHours < 24;
                            string badgeClass = isUrgent ? "bg-danger text-white" : "bg-soft-primary text-primary";
                            string timeText = isUrgent ? "Today!" : task.DueDate.ToString("dd MMM");

                            <a asp-controller="ToDo" asp-action="Details" asp-route-id="@task.Id" class="list-group-item list-group-item-action d-flex align-items-center p-3 task-card-item shadow-sm mb-3 rounded-3 border-0">
                                <div class="me-3 text-center" style="min-width: 60px;">
                                    <div class="badge @badgeClass rounded-pill py-2 px-3 fw-bold">@timeText</div>
                                    @if (isUrgent)
                                    {
                                        <div class="small text-danger fw-bold mt-1">Urgent</div>
                                    }
                                </div>
                                <div class="flex-grow-1 overflow-hidden ps-3 border-start">
                                    <h6 class="mb-1 fw-bold text-truncate">@task.Title</h6>
                                    <div class="d-flex align-items-center small text-muted">
                                        <i class="bi bi-flag-fill me-1 @(task.Priority == "High" ? "text-danger" : "text-warning")"></i>
                                        @task.Priority Priority
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted opacity-50"></i>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-8">
                <div id="calendar-container">
                    <div id="calendar"></div>
                </div>
            </div>

        </div>
    </div>

    <div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content soft-card border-0">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pb-4">
                    <div class="mb-3 text-primary opacity-75"><i class="bi bi-calendar-plus display-4"></i></div>
                    <h5 class="fw-bold mb-2">Plan for <span id="selectedDateText" class="text-primary"></span></h5>
                    <p class="text-muted small mb-4">Choose an action:</p>

                    <div class="d-grid gap-3">
                        <a id="btnNewTask" href="#" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-check2-square me-2"></i>New Task
                        </a>
                        <a id="btnNewGoal" href="#" class="btn btn-info text-white btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-trophy-fill me-2"></i>New Goal
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek'
                },
                height: 650,
                // Sigurohu qe ky Action 'GetCalendarEvents' ekziston ne HomeController
                events: '/Home/GetCalendarEvents',
                eventTimeFormat: { hour: '2-digit', minute: '2-digit', meridiem: false },
                dateClick: function(info) {
                    document.getElementById('selectedDateText').innerText = info.dateStr;
                    var dateParam = info.dateStr + "T09:00";
                    document.getElementById('btnNewTask').href = "/ToDo/Create?prefillDate=" + dateParam;
                    // document.getElementById('btnNewGoal').href = "/LifeGoals/Create?prefillDate=" + info.dateStr;
                    var myModal = new bootstrap.Modal(document.getElementById('createModal'));
                    myModal.show();
                }
            });
            calendar.render();
        });
    </script>
}
else
{

    // LANDING PAGE

    <style>
        .hero-section {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.5)), url('https://images.unsplash.com/photo-1506784983877-45594efa4cbe?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed; 
