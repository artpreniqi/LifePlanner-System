                </div>
                <div class="col-lg-5 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/3014/3014209.png" alt="Mobile App" style="max-height: 300px; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)); transform: rotate(-10deg);">
                </div>
            </div>
