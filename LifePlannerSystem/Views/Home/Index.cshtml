                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-5 text-center">
        <h2 class="fw-bold mb-4">Ready to get organized?</h2>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow">Join LifePlanner Now</a>
    </div>
}